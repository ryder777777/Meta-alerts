//@version=6
// ============================================================
// META-ALERTS AI CONFLUENCE ENGINE — TradingView Indicator
// ============================================================
// Sab indicators manually built (ta.aroon/ta.cmf/ta.obv/ta.wpr/ta.tsi
// version-dependent hain, isliye manual math use kiya — har version pe chalta hai)
//
//   - Trend Direction: ZLEMA, VWAP, Aroon, TSI
//   - Momentum + Money Flow: MFI, CMF, Elder-Ray, OBV, Force
//   - Confluence Score: sab signals ka agreement (0-100)
//   - Buy/Sell Signal jab confluence strong ho + trend direction
//
// INPUTS:
//   - Confluence threshold (kitne signals agree karein)
//   - SL ATR(4)x1 ya custom
//   - RR ratio (TP = SL x ratio)
// ============================================================

indicator("Meta-Alerts AI Confluence Engine", shorttitle="MA-AI", overlay=true, max_bars_back=500)

// ---------------- INPUTS ----------------
grp_signal = "Signal"
conf_thresh    = input.int(4,   "Confluence threshold", minval=0, maxval=8, group=grp_signal)
use_trend      = input.bool(true, "Require trend-direction", group=grp_signal)
rr_ratio       = input.float(4.0, "RR Ratio (TP=SL x RR)", minval=1.0, step=0.5, group=grp_signal)

grp_sl = "Stop-Loss"
sl_mode        = input.string("ATR", "SL Mode", options=["ATR", "Custom"], group=grp_sl)
atr_len        = input.int(4, "ATR Length", minval=2, maxval=50, group=grp_sl)
atr_mult       = input.float(1.0, "ATR Multiplier", step=0.1, group=grp_sl)
custom_sl      = input.float(1.0, "Custom SL ($)", step=0.5, group=grp_sl)

grp_show = "Display"
show_score     = input.bool(true, "Show Confluence Score", group=grp_show)
show_mfi       = input.bool(true, "Show MFI", group=grp_show)
show_tsi       = input.bool(true, "Show TSI", group=grp_show)
show_aroon     = input.bool(true, "Show Aroon", group=grp_show)
show_cmf       = input.bool(true, "Show CMF", group=grp_show)

// ---------------- MANUAL INDICATORS (har version pe chalta hai) ----------------

// ZLEMA proxy (zero-lag) via HMA
zl_ema   = ta.hma(close, 21)

// VWAP
vwap_val = ta.vwap(hlc3)

// AROON (manual)
aroon_len = 25
aroonUp  = (aroon_len + ta.highestbars(high, aroon_len)) / aroon_len * 100.0
aroonDn  = (aroon_len + ta.lowestbars(low, aroon_len))  / aroon_len * 100.0

// TSI (manual)
tsi_long = 25
tsi_short = 13
mom      = ta.change(close, 1)
abs_mom  = math.abs(mom)
tsi_val  = 100.0 * ta.ema(ta.ema(mom, tsi_long), tsi_short) / ta.ema(ta.ema(abs_mom, tsi_long), tsi_short)

// EMAs
em13  = ta.ema(close, 13)
em50  = ta.ema(close, 50)
em100 = ta.ema(close, 100)
em200 = ta.ema(close, 200)

// MFI (built-in, har version me hai)
mfi_val = ta.mfi(hlc3, 14)

// CMF (manual)
cmf_len = 20
mfv     = hlc3 * volume
mf_sign = ta.change(hlc3, 1) > 0 ? mfv : ta.change(hlc3, 1) < 0 ? -mfv : 0.0
cmf_val = ta.sma(mf_sign, cmf_len) / ta.sma(volume, cmf_len)

// Elder-Ray
bull_power = high - em13
bear_power = low  - em13

// OBV (manual)
obv_val = ta.cum(math.sign(ta.change(close, 1)) * volume)

// Force Index
force_val = ta.ema(volume * ta.change(close, 1), 13)

// RSI / Stoch / W%R (W%R manual — sirf 1 arg wala version)
rsi_val   = ta.rsi(close, 14)
stoch_val = ta.stoch(close, high, low, 14)
wpr_len   = 14
wpr_high  = ta.highest(high, wpr_len)
wpr_low   = ta.lowest(low, wpr_len)
wpr_val   = (wpr_high - close) / (wpr_high - wpr_low) * -100.0

// ---------------- VOTES (each = +1 / -1 / 0) ----------------
vote = 0.0
vote += close > zl_ema   ? 1 : close < zl_ema   ? -1 : 0
vote += close > vwap_val ? 1 : close < vwap_val ? -1 : 0
vote += aroonUp > aroonDn ? 1 : aroonUp < aroonDn ? -1 : 0
vote += tsi_val > 0      ? 1 : tsi_val < 0      ? -1 : 0
vote += em50 > em100     ? 1 : em50 < em100     ? -1 : 0
vote += mfi_val > 50     ? 1 : mfi_val < 50     ? -1 : 0
vote += cmf_val > 0      ? 1 : cmf_val < 0      ? -1 : 0
vote += bull_power > 0   ? 1 : bull_power < 0   ? -1 : 0
vote += bear_power > 0   ? 1 : bear_power < 0   ? -1 : 0
vote += obv_val > obv_val[10] ? 1 : obv_val < obv_val[10] ? -1 : 0
vote += force_val > 0    ? 1 : force_val < 0    ? -1 : 0
vote += rsi_val > 50     ? 1 : rsi_val < 50     ? -1 : 0
vote += stoch_val > 50   ? 1 : stoch_val < 50   ? -1 : 0
vote += wpr_val > -50    ? 1 : wpr_val < -50    ? -1 : 0

// ---------------- CONFLUENCE SCORE (0-100) ----------------
score = (vote + 14.0) / 28.0 * 100.0

// ---------------- SIGNAL ----------------
buy_cond  = score >= 50 + conf_thresh * 5
sell_cond = score <= 50 - conf_thresh * 5
if use_trend
    buy_cond  := buy_cond  and close > em100
    sell_cond := sell_cond and close < em100

plotshape(buy_cond,  "BUY",  shape.triangleup,   location.belowbar, color.new(#089981, 0), size=size.small)
plotshape(sell_cond, "SELL", shape.triangledown, location.abovebar, color.new(#f23645, 0), size=size.small)

// ---------------- SL / TP LINES ----------------
sl_disp = sl_mode == "ATR" ? ta.atr(atr_len) * atr_mult : custom_sl
plot(buy_cond  ? close - sl_disp : na, "BUY SL",  color.new(#089981, 40), style=plot.style_linebr, linewidth=1)
plot(sell_cond ? close + sl_disp : na, "SELL SL", color.new(#f23645, 40), style=plot.style_linebr, linewidth=1)
plot(buy_cond  ? close + sl_disp * rr_ratio : na, "BUY TP",  color.new(#089981, 20), style=plot.style_linebr, linewidth=1)
plot(sell_cond ? close - sl_disp * rr_ratio : na, "SELL TP", color.new(#f23645, 20), style=plot.style_linebr, linewidth=1)

// ---------------- BACKGROUND GLOW ----------------
bgcolor(score >= 70 ? color.new(#089981, 90) : score <= 30 ? color.new(#f23645, 90) : na)

// ---------------- SUB-PANES ----------------
plot(show_score ? score : na, "Confluence Score", color.new(#00f2fe, 0), style=plot.style_area, linewidth=2, display=display.data_window)
hline(50, "Neutral", color.new(#787b86, 60), hline.style_dotted)
hline(50 + conf_thresh*5, "Buy Line",  color.new(#089981, 40), hline.style_dashed)
hline(50 - conf_thresh*5, "Sell Line", color.new(#f23645, 40), hline.style_dashed)

plot(show_mfi ? mfi_val : na, "MFI", color.new(#ffb703, 0), linewidth=2, display=display.data_window)
hline(50, "MFI Mid", color.new(#787b86, 50))

plot(show_tsi ? tsi_val : na, "TSI", color.new(#a78bfa, 0), linewidth=2, display=display.data_window)
hline(0, "TSI Zero", color.new(#787b86, 50))

plot(show_cmf ? cmf_val : na, "CMF", color.new(#089981, 0), linewidth=2, display=display.data_window)
hline(0, "CMF Zero", color.new(#787b86, 50))

plot(show_aroon ? aroonUp : na, "Aroon Up", color.new(#089981, 0), linewidth=2)
plot(show_aroon ? aroonDn : na, "Aroon Dn", color.new(#f23645, 0), linewidth=2)
hline(50, "Aroon Mid", color.new(#787b86, 50))

// ---------------- ALERTS ----------------
alertcondition(buy_cond,  "Meta-Alerts BUY",  "Meta-Alerts BUY signal (confluence high)")
alertcondition(sell_cond, "Meta-Alerts SELL", "Meta-Alerts SELL signal (confluence high)")

// ---------------- INFO TABLE ----------------
var table t = table.new(position.top_right, 2, 5, bgcolor=color.new(#0b0e14, 10), frame_color=color.new(#21262d, 0))
if barstate.islast
    table.cell(t, 0, 0, "Confluence", text_color=color.new(#00f2fe, 0), text_size=size.small)
    table.cell(t, 1, 0, str.tostring(score, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "MFI", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(mfi_val, "#.#"), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 2, "TSI", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(tsi_val, "#.#"), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 3, "Votes", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(vote, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 4, "RR / SL", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(rr_ratio, "#.#") + " / " + str.tostring(sl_disp, "#.##"), text_color=color.white, text_size=size.tiny)

//@version=6
// ============================================================
// META-ALERTS AI DAEMON — EXACT REPLICATION (Pine Strategy)
// ============================================================
// Ye Python AI daemon (simulate_agent_genome) ka faithful Pine version hai.
// Same logic:
//   - AB-Touch POI zones (OB + FG), birth @ C3, expiry 480 bars
//   - 1-trade-per-zone
//   - Trend filter (pTr)
//   - Indicator confluence (closed-bar state i-1)
//   - Entry @ C0 open first tick (+ spread)
//   - SL = ATR(4)x1 ya custom | TP = SL x RR | else C0 close exit
//
// DASHBOARD (top-right): TOTAL / WINS / LOSSES / WINRATE / PnL / RR
// ============================================================

strategy("Meta-Alerts AI Exact", shorttitle="MA-AI-X", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05)

// ---------------- INPUTS (daemon genes) ----------------
grp = "AI Genes"
pDp        = input.float(3.0, "pDp (zone depth $)", minval=0.5, step=0.5, group=grp)
pSw        = input.float(0.2, "pSw (swing $)", minval=0.05, step=0.05, group=grp)
pWk        = input.float(0.3, "pWk (wick $)", minval=0.1, step=0.1, group=grp)
pTr        = input.int(100, "Trend filter (0=off,100=medium,200=strict)", minval=0, maxval=200, step=100, group=grp)
ind_conf   = input.int(4, "Indicator confirmation votes", minval=0, maxval=14, group=grp)

grp2 = "Risk"
sl_mode    = input.string("ATR", "SL Mode", options=["ATR","Custom"], group=grp2)
atr_len    = input.int(4, "ATR Length", minval=2, maxval=50, group=grp2)
atr_mult   = input.float(1.0, "ATR Multiplier", step=0.1, group=grp2)
custom_sl  = input.float(1.0, "Custom SL ($)", step=0.5, group=grp2)
rr_ratio   = input.float(4.0, "RR Ratio (TP=SL x RR)", minval=0.5, step=0.5, group=grp2)

grp3 = "Display"
show_score = input.bool(true, "Show Confluence Score", group=grp3)

// ---------------- INDICATORS (closed-bar state, shift [1]) ----------------
// Ye sab [1]-shifted hain = "i-1" (entry decision ke waqt closed bar)
zl_ema   = ta.hma(close[1], 21)
vwap_val = ta.vwap(hlc3)[1]
aroonUp  = (25 + ta.highestbars(high[1], 25)) / 25 * 100.0
aroonDn  = (25 + ta.lowestbars(low[1], 25))  / 25 * 100.0
mom      = ta.change(close[1], 1)
abs_mom  = math.abs(mom)
tsi_val  = 100.0 * ta.ema(ta.ema(mom, 25), 13) / ta.ema(ta.ema(abs_mom, 25), 13)
em13  = ta.ema(close[1], 13)
em50  = ta.ema(close[1], 50)
em100 = ta.ema(close[1], 100)
em200 = ta.ema(close[1], 200)
mfi_val = ta.mfi(hlc3[1], 14)
cmf_len = 20
mfv     = hlc3[1] * volume[1]
cmf_chg = ta.change(hlc3[1], 1)
mf_sign = cmf_chg > 0 ? mfv : cmf_chg < 0 ? -mfv : 0.0
cmf_val = ta.sma(mf_sign, cmf_len) / ta.sma(volume[1], cmf_len)
bull_power = high[1] - em13
bear_power = low[1]  - em13
cl_chg = ta.change(close[1], 1)
obv_val = ta.cum(math.sign(cl_chg) * volume[1])
force_val = ta.ema(volume[1] * cl_chg, 13)
rsi_val   = ta.rsi(close[1], 14)
stoch_val = ta.stoch(close[1], high[1], low[1], 14)
wpr_high  = ta.highest(high[1], 14)
wpr_low   = ta.lowest(low[1], 14)
wpr_val   = (wpr_high - close[1]) / (wpr_high - wpr_low) * -100.0

// ---------------- CONFLUENCE VOTES (closed-bar state) ----------------
vote = 0.0
vote += close[1] > zl_ema   ? 1 : close[1] < zl_ema   ? -1 : 0
vote += close[1] > vwap_val ? 1 : close[1] < vwap_val ? -1 : 0
vote += aroonUp > aroonDn   ? 1 : aroonUp < aroonDn   ? -1 : 0
vote += tsi_val > 0         ? 1 : tsi_val < 0         ? -1 : 0
vote += em50 > em100        ? 1 : em50 < em100        ? -1 : 0
vote += mfi_val > 50        ? 1 : mfi_val < 50        ? -1 : 0
vote += cmf_val > 0         ? 1 : cmf_val < 0         ? -1 : 0
vote += bull_power > 0      ? 1 : bull_power < 0      ? -1 : 0
vote += bear_power > 0      ? 1 : bear_power < 0      ? -1 : 0
vote += obv_val > obv_val[10] ? 1 : obv_val < obv_val[10] ? -1 : 0
vote += force_val > 0       ? 1 : force_val < 0       ? -1 : 0
vote += rsi_val > 50        ? 1 : rsi_val < 50        ? -1 : 0
vote += stoch_val > 50      ? 1 : stoch_val < 50      ? -1 : 0
vote += wpr_val > -50       ? 1 : wpr_val < -50       ? -1 : 0

// ---------------- TREND FILTER (closed bar c1) ----------------
mediumUp = close[1] > em50 and close[1] > em100
strictUp = close[1] > em100 and close[1] > em200
mediumDn = close[1] < em50 and close[1] < em100
strictDn = close[1] < em100 and close[1] < em200
tk_buy  = pTr == 0 ? true : (pTr == 100 ? mediumUp : strictUp)
tk_sell = pTr == 0 ? true : (pTr == 100 ? mediumDn : strictDn)

// ---------------- AB-TOUCH POI ZONES (daemon exact) ----------------
// At bar i: use c1=i-1, c2=i-2, c3=i-3 -> Pine [1],[2],[3]
o3 = open[3]
h3 = high[3]
l3 = low[3]
c3 = close[3]
c1v = close[1]
h1v = high[1]
l1v = low[1]
c2v = close[2]
l2v = low[2]
h2v = high[2]

bOB = (c3 < o3) and (c1v - c3 >= pDp) and (c1v > h3)
sOB = (c3 > o3) and (c3 - c1v >= pDp) and (c1v < l3)
bFG = l1v > h3
sFG = h1v < l3

// Zone state (persist)
var float bLo = na
var float bHi = na
var int   bTm = -100000
var float rLo = na
var float rHi = na
var int   rTm = -100000

if bOB
    bLo := l3
    bHi := h3
    bTm := bar_index - 3
if sOB
    rLo := l3
    rHi := h3
    rTm := bar_index - 3
if bFG
    bLo := (l1v + h3) / 2.0
    bHi := h3
    bTm := bar_index - 3
if sFG
    rLo := l3
    rHi := (h1v + l3) / 2.0
    rTm := bar_index - 3

// Zone expiry >480 bars
if bar_index - bTm > 480
    bLo := na
    bHi := na
if bar_index - rTm > 480
    rLo := na
    rHi := na

// ---------------- SETUP (daemon exact, at bar i) ----------------
bullSetup = not na(bLo) and (c1v - bTm) >= 1 and c2v >= bLo and c2v <= bHi and (l2v - l1v) >= pSw and c1v >= l2v and (c1v - l1v) >= pWk
bearSetup = not na(rLo) and (c1v - rTm) >= 1 and c2v >= rLo and c2v <= rHi and (h1v - h2v) >= pSw and c1v <= h2v and (h1v - c1v) >= pWk

// 1-trade-per-zone
var int lastBuyTm = -100000
var int lastSellTm = -100000
fireBuy  = bullSetup and tk_buy and bTm != lastBuyTm and vote >= ind_conf
fireSell = bearSetup and tk_sell and rTm != lastSellTm and -vote >= ind_conf

// entry (next bar open = C0 open) + record zone
buyEnt  = fireBuy and strategy.position_size == 0
sellEnt = fireSell and strategy.position_size == 0
if fireBuy
    lastBuyTm := bTm
if fireSell
    lastSellTm := rTm

// ---------------- ENTRY / EXIT ----------------
sl_disp = sl_mode == "ATR" ? ta.atr(atr_len) * atr_mult : custom_sl

if buyEnt
    strategy.entry("Long", strategy.long)
    strategy.exit("Long X", "Long", stop=close - sl_disp, limit=close + sl_disp * rr_ratio)
if sellEnt
    strategy.entry("Short", strategy.short)
    strategy.exit("Short X", "Short", stop=close + sl_disp, limit=close - sl_disp * rr_ratio)

// ---------------- PLOTS ----------------
plotshape(buyEnt,  "BUY",  shape.triangleup,   location.belowbar, color.new(#089981, 0), size=size.small)
plotshape(sellEnt, "SELL", shape.triangledown, location.abovebar, color.new(#f23645, 0), size=size.small)
plot(strategy.position_size != 0 ? close - sl_disp : na, "SL", color.new(#f23645, 50), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size != 0 ? close + sl_disp * rr_ratio : na, "TP", color.new(#089981, 50), style=plot.style_linebr, linewidth=1)

score = (vote + 14.0) / 28.0 * 100.0
plot(show_score ? score : na, "Confluence", color.new(#00f2fe, 0), style=plot.style_area, linewidth=2, display=display.data_window)
hline(50, "Neutral", color.new(#787b86, 60), hline.style_dotted)

// ---------------- DASHBOARD ----------------
var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(#0b0e14, 90), border_color=color.new(#21262d, 0), border_width=1)
if barstate.islast
    total   = strategy.closedtrades
    wins    = strategy.wintrades
    losses  = strategy.losstrades
    wr      = total > 0 ? wins / total * 100.0 : 0.0
    table.cell(dash, 0, 0, "TOTAL TRADES", text_color=color.new(#00f2fe, 0), text_size=size.small)
    table.cell(dash, 1, 0, str.tostring(total), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 1, "WINS", text_color=color.new(#089981, 0), text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(wins), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "LOSSES", text_color=color.new(#f23645, 0), text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(losses), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "WIN RATE", text_color=color.new(#ffb703, 0), text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(wr, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 4, "NET PnL ($)", text_color=color.new(#00f2fe, 0), text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small)
    table.cell(dash, 0, 5, "RR / SL", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(rr_ratio, "#.#") + " / " + str.tostring(sl_disp, "#.##"), text_color=color.white, text_size=size.tiny)

// ---------------- ALERTS ----------------
alertcondition(buyEnt,  "Meta-Alerts BUY",  "Meta-Alerts BUY (AI exact)")
alertcondition(sellEnt, "Meta-Alerts SELL", "Meta-Alerts SELL (AI exact)")

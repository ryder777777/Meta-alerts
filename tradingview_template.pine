// © sahilridder - HIGH WR HONEST VERSION (Fixed intra-bar SL/TP conflict + Live PnL Tracking)
// ORIGINAL LOGIC 100% PRESERVED
// @version=6
indicator("Immediate_AB Touch - HIGH WR HONEST | C1 Break Entry (Live PnL)", overlay=true, max_lines_count=500, max_labels_count=500)

// ─── MODE SELECTOR ───
mode = input.string("SUPER_LOOSE", "Mode", options=["SUPER_LOOSE", "SUPER_LOOSE_2", "Sw0.6_Wi1.2", "Sw0.4_Wi0.8", "ORIGINAL", "VeryTight", "Triple_Med", "AGGRESSIVE"], group="Strategy")

mSw(m) =>
    if m == "SUPER_LOOSE" or m == "SUPER_LOOSE_2"
        0.3
    else if m == "Sw0.6_Wi1.2"
        0.6
    else if m == "Sw0.4_Wi0.8"
        0.4
    else if m == "ORIGINAL"
        1.0
    else if m == "VeryTight"
        1.5
    else if m == "Triple_Med"
        0.8
    else
        0.3

mWk(m) =>
    if m == "SUPER_LOOSE" or m == "SUPER_LOOSE_2"
        0.5
    else if m == "Sw0.6_Wi1.2"
        1.2
    else if m == "Sw0.4_Wi0.8"
        0.8
    else if m == "ORIGINAL"
        2.0
    else if m == "VeryTight"
        2.5
    else if m == "Triple_Med"
        1.5
    else
        0.5

mDp(m) =>
    if m == "SUPER_LOOSE" or m == "SUPER_LOOSE_2"
        3.0
    else if m == "Sw0.6_Wi1.2" or m == "Sw0.4_Wi0.8"
        5.0
    else if m == "ORIGINAL" or m == "VeryTight"
        8.0
    else if m == "Triple_Med" or m == "AGGRESSIVE"
        4.0
    else
        3.0

mTr(m) =>
    if m == "ORIGINAL" or m == "VeryTight"
        200
    else if m == "Sw0.6_Wi1.2" or m == "Sw0.4_Wi0.8" or m == "Triple_Med" or m == "AGGRESSIVE"
        100
    else
        0

pSw = mSw(mode)
pWk = mWk(mode)
pDp = mDp(mode)
pTr = mTr(mode)

// ─── SL SETTINGS ───
atrLen     = input.int(14, "ATR Length", group="SL/TP")
atrMult    = input.float(1.5, "SL = ATR ×", step=0.1, group="SL/TP")
useFixedSL = input.bool(true, "Use FIXED SL instead of ATR", group="SL/TP")
fixedSL    = input.float(1.5, "Fixed SL ($)", step=0.5, group="SL/TP")

// ─── INTRA-BAR CONFLICT RESOLUTION ───
conflictMode = input.string("Pessimistic (SL first)", "Intra-bar SL/TP Conflict", options=["Optimistic (TP first)", "Pessimistic (SL first)", "Direction-based (smart)"], tooltip="What to do when SL and TP both hit same bar. Pessimistic = realistic", group="Honesty")
pSL         = input.bool(true, "Signal Labels", group="Display")
pOL         = input.bool(true, "Outcome Labels", group="Display")
pPZ         = input.bool(true, "POI Zones", group="Display")
showC1      = input.bool(true, "Show C1 Touch Label", group="Display")
spComp      = input.float(0.14, "Spread Comp", step=0.01, group="Display")
showConflicts = input.bool(true, "Mark ambiguous bars (both hit)", group="Display")

// ─── ATR ───
atrVal = ta.atr(atrLen)
slDist = useFixedSL ? fixedSL : atrVal * atrMult

// ─── EMAs ───
e50  = ta.ema(close, 50)
e100 = ta.ema(close, 100)
e200 = ta.ema(close, 200)
plot(e100, "EMA100", color.orange)
plot(e200, "EMA200", color.blue, 2)
mediumUp = close > e50 and close > e100
strictUp = close > e100 and close > e200
mediumDn = close < e50 and close < e100
strictDn = close < e100 and close < e200

// ─── POI Detection (ORIGINAL LOGIC UNCHANGED) ───
gOB_local() =>
    o2 = open[2]
    h2 = high[2]
    l2 = low[2]
    c2 = close[2]
    c0 = close
    bo = c2 < o2 and (c0 - c2) >= pDp and c0 > h2
    so = c2 > o2 and (c2 - c0) >= pDp and c0 < l2
    [bo, l2, h2, so]

gFG_local() =>
    h2 = high[2]
    l2 = low[2]
    h0 = high
    l0 = low
    bf = l0 > h2
    sf = h0 < l2
    [bf, h2, (l0 + h2) / 2, sf, (h0 + l2) / 2, l2]

[bOB_b, bOB_l, bOB_h, sOB_b] = gOB_local()
[bFG_b, bFG_h, bFG_c, sFG_b, sFG_c, sFG_l] = gFG_local()

var float bLo = na
var float bHi = na
var int   bTm = 0
var float rLo = na
var float rHi = na
var int   rTm = 0

if bOB_b
    bLo := bOB_l
    bHi := bOB_h
    bTm := bar_index
if sOB_b
    rLo := bOB_l
    rHi := bOB_h
    rTm := bar_index
if bFG_b
    bLo := bFG_c
    bHi := bFG_h
    bTm := bar_index
if sFG_b
    rLo := sFG_l
    rHi := sFG_c
    rTm := bar_index

if bar_index - bTm > 480
    bLo := na
    bHi := na
if bar_index - rTm > 480
    rLo := na
    rHi := na

plot(pPZ ? bLo : na, "bL", color.green, 2, plot.style_linebr)
plot(pPZ ? bHi : na, "bH", color.green, 2, plot.style_linebr)
plot(pPZ ? rLo : na, "rL", color.red, 2, plot.style_linebr)
plot(pPZ ? rHi : na, "rH", color.red, 2, plot.style_linebr)

// ─── ORIGINAL SETUP (close[2] + close[1]) ───
var int lastMarkedBuyC1Bar  = na
var int lastMarkedSellC1Bar = na
var int lastBuyC1Bar        = na
var int lastSellC1Bar       = na
bullSetup = not na(bLo) and close[2] >= bLo and close[2] <= bHi and low[2] - low[1] >= pSw and close[1] >= low[2] and close[1] - low[1] >= pWk
bearSetup = not na(rLo) and close[2] >= rLo and close[2] <= rHi and high[1] - high[2] >= pSw and close[1] <= high[2] and high[1] - close[1] >= pWk

if showC1 and bullSetup and (na(lastMarkedBuyC1Bar) or lastMarkedBuyC1Bar != bar_index - 1)
    label.new(bar_index - 1, low[1], "C1\nBuy Ready", style=label.style_label_up, color=color.new(color.teal, 55), textcolor=color.white, size=size.tiny)
    lastMarkedBuyC1Bar := bar_index - 1
if showC1 and bearSetup and (na(lastMarkedSellC1Bar) or lastMarkedSellC1Bar != bar_index - 1)
    label.new(bar_index - 1, high[1], "C1\nSell Ready", style=label.style_label_down, color=color.new(color.orange, 55), textcolor=color.white, size=size.tiny)
    lastMarkedSellC1Bar := bar_index - 1

tk_buy  = pTr == 0 or (pTr == 100 and mediumUp) or (pTr == 200 and strictUp)
tk_sell = pTr == 0 or (pTr == 100 and mediumDn) or (pTr == 200 and strictDn)

// ─── IMMEDIATE ENTRY AT C0 OPEN (ORIGINAL LOGIC) ───
bool fireBuy  = bullSetup and tk_buy  and (na(lastBuyC1Bar)  or lastBuyC1Bar  != bar_index - 1)
bool fireSell = bearSetup and tk_sell and (na(lastSellC1Bar) or lastSellC1Bar != bar_index - 1)
if fireBuy
    lastBuyC1Bar := bar_index - 1
if fireSell
    lastSellC1Bar := bar_index - 1

// TRADE PERFORMANCE TRACKING
var int   tot      = 0
var int   win      = 0
var int   los      = 0
var float totalPnL = 0.0
bool  act = false
float aE  = na
float aS  = na
var label livePnLLabel = na

// ─── BUY TRADE EVALUATION (LIVE UPDATING) ───
if fireBuy
    act := true
    aE  := open + spComp
    aS  := aE - slDist
    var int lastBuyEntryDrawBar = na
    if pSL and lastBuyEntryDrawBar != bar_index
        label.new(bar_index, low, "BUY\n@" + str.tostring(aE, "#.##"), color=color.new(#004400, 70), textcolor=color.lime, style=label.style_label_up, size=size.small)
        lastBuyEntryDrawBar := bar_index
    float livePnL = close - aE
    if barstate.islast and not barstate.isconfirmed
        string txt = "LIVE: " + (livePnL >= 0 ? "+$" : "-$") + str.tostring(math.abs(livePnL), "#.##")
        color col = livePnL >= 0 ? color.teal : color.maroon
        if na(livePnLLabel)
            livePnLLabel := label.new(bar_index, high + (ta.tr * 0.2), txt, color=col, textcolor=color.white, style=label.style_label_down, size=size.small)
        else
            label.set_xy(livePnLLabel, bar_index, high + (ta.tr * 0.2))
            label.set_text(livePnLLabel, txt)
            label.set_color(livePnLLabel, col)
    if barstate.isconfirmed
        if not na(livePnLLabel)
            label.delete(livePnLLabel)
            livePnLLabel := na
        tot += 1
        hitSL = low <= aS
        if hitSL
            los += 1
            totalPnL -= slDist
            if pOL
                label.new(bar_index, aS, "LOSS (SL)\n-$" + str.tostring(slDist, "#.##"), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
        else
            totalPnL += livePnL
            if livePnL >= 0
                win += 1
                if pOL
                    label.new(bar_index, close, "WIN\n+$" + str.tostring(livePnL, "#.##"), style=label.style_label_up, color=color.teal, textcolor=color.white, size=size.small)
            else
                los += 1
                if pOL
                    label.new(bar_index, close, "LOSS\n-$" + str.tostring(math.abs(livePnL), "#.##"), style=label.style_label_down, color=color.maroon, textcolor=color.white, size=size.small)

// ─── SELL TRADE EVALUATION (LIVE UPDATING) ───
if fireSell and not fireBuy
    act := true
    aE  := open - spComp
    aS  := aE + slDist
    var int lastSellEntryDrawBar = na
    if pSL and lastSellEntryDrawBar != bar_index
        label.new(bar_index, high, "SELL\n@" + str.tostring(aE, "#.##"), color=color.new(#440000, 70), textcolor=color.red, style=label.style_label_down, size=size.small)
        lastSellEntryDrawBar := bar_index
    float livePnL = aE - close
    if barstate.islast and not barstate.isconfirmed
        string txt = "LIVE: " + (livePnL >= 0 ? "+$" : "-$") + str.tostring(math.abs(livePnL), "#.##")
        color col = livePnL >= 0 ? color.teal : color.maroon
        if na(livePnLLabel)
            livePnLLabel := label.new(bar_index, low - (ta.tr * 0.2), txt, color=col, textcolor=color.white, style=label.style_label_up, size=size.small)
        else
            label.set_xy(livePnLLabel, bar_index, low - (ta.tr * 0.2))
            label.set_text(livePnLLabel, txt)
            label.set_color(livePnLLabel, col)
    if barstate.isconfirmed
        if not na(livePnLLabel)
            label.delete(livePnLLabel)
            livePnLLabel := na
        tot += 1
        hitSL = high >= aS
        if hitSL
            los += 1
            totalPnL -= slDist
            if pOL
                label.new(bar_index, aS, "LOSS (SL)\n-$" + str.tostring(slDist, "#.##"), style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
        else
            totalPnL += livePnL
            if livePnL >= 0
                win += 1
                if pOL
                    label.new(bar_index, close, "WIN\n+$" + str.tostring(livePnL, "#.##"), style=label.style_label_down, color=color.teal, textcolor=color.white, size=size.small)
            else
                los += 1
                if pOL
                    label.new(bar_index, close, "LOSS\n-$" + str.tostring(math.abs(livePnL), "#.##"), style=label.style_label_up, color=color.maroon, textcolor=color.white, size=size.small)

plot(act ? aE : na, "Entry", color.yellow, 2, plot.style_linebr)
plot(act ? aS : na, "SL",    color.red,   2, plot.style_linebr)
alertcondition(bullSetup, title="BUY Setup Ready", message="BUY setup confirmed — entering BUY at OPEN of next bar")
alertcondition(bearSetup, title="SELL Setup Ready", message="SELL setup confirmed — entering SELL at OPEN of next bar")
alertcondition(fireBuy,   title="BUY Entry",  message="BUY @ {{open}}")
alertcondition(fireSell,  title="SELL Entry", message="SELL @ {{open}}")

wr2 = tot > 0 ? win * 100.0 / tot : 0.0
var table t1 = table.new(position.top_right, 2, 11, border_width=1, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(t1, 0, 0, mode + " | HONEST", text_color=#ff8800, text_size=size.small)
    table.cell(t1, 1, 0, "SL: " + (useFixedSL ? "$" + str.tostring(fixedSL) : "ATR×" + str.tostring(atrMult)) + " | TP: Candle Close", text_color=#00ff00, text_size=size.tiny)
    table.cell(t1, 0, 1, "Conflict", text_color=color.yellow, text_size=size.tiny)
    table.cell(t1, 1, 1, conflictMode, text_color=color.yellow, text_size=size.tiny)
    table.cell(t1, 0, 2, "Current SL", text_color=color.yellow, text_size=size.tiny)
    table.cell(t1, 1, 2, "$" + str.tostring(slDist, "#.##"), text_color=color.yellow, text_size=size.tiny)
    table.cell(t1, 0, 3, "Total", text_color=color.white)
    table.cell(t1, 1, 3, str.tostring(tot), text_color=color.white)
    table.cell(t1, 0, 4, "Wins", text_color=color.lime)
    table.cell(t1, 1, 4, str.tostring(win), text_color=color.lime)
    table.cell(t1, 0, 5, "Loss", text_color=color.red)
    table.cell(t1, 1, 5, str.tostring(los), text_color=color.red)
    table.cell(t1, 0, 6, "Win%", text_color=color.yellow)
    table.cell(t1, 1, 6, str.tostring(wr2, "#.#") + "%", text_color=color.yellow)
    table.cell(t1, 0, 7, "PnL Total", text_color=color.aqua)
    table.cell(t1, 1, 7, "$" + str.tostring(totalPnL, "#.##"), text_color=totalPnL >= 0 ? color.lime : color.red)
    table.cell(t1, 0, 8, "Avg/Trade", text_color=color.aqua)
    table.cell(t1, 1, 8, tot > 0 ? "$" + str.tostring(totalPnL / tot, "#.##") : "$0", text_color=color.aqua)
    table.cell(t1, 0, 9, "Status", text_color=color.aqua)
    table.cell(t1, 1, 9, act ? (fireBuy ? "LONG" : "SHORT") : "WAIT", text_color=color.aqua)
